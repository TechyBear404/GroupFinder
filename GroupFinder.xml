                        <Offset>
                            <AbsDimension x="315" y="-5"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        GroupFinderCreateFrame:Hide();
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Instance Display -->
            <FontString name="$parentInstanceDisplay" inherits="GameFontHighlight">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="25" y="-50"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Text>The Deadmines (17-26 - Dungeon)</Text>
            </FontString>

            <!-- Select Instance Button -->
            <Button name="$parentInstanceButton" inherits="UIPanelButtonTemplate" text="Select Instance">
                <Size>
                    <AbsDimension x="120" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="205" y="-50"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        GroupFinder_ShowInstanceDropdown();
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Roles Label -->
            <FontString name="$parentRolesLabel" inherits="GameFontNormal">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="25" y="-85"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Text>Roles Needed:</Text>
            </FontString>

            <!-- Tank Checkbox -->
            <CheckButton name="$parentTankCheck" inherits="OptionsCheckButtonTemplate">
                <Size>
                    <AbsDimension x="20" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="25" y="-110"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        this:SetChecked(true);
                    </OnLoad>
                </Scripts>
            </CheckButton>

            <!-- Tank Label -->
            <FontString name="$parentTankLabel" inherits="GameFontNormal">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="50" y="-110"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Text>Tank</Text>
            </FontString>

            <!-- Healer Checkbox -->
            <CheckButton name="$parentHealerCheck" inherits="OptionsCheckButtonTemplate">
                <Size>
                    <AbsDimension x="20" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="120" y="-110"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        this:SetChecked(true);
                    </OnLoad>
                </Scripts>
            </CheckButton>

            <!-- Healer Label -->
            <FontString name="$parentHealerLabel" inherits="GameFontNormal">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="145" y="-110"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Text>Healer</Text>
            </FontString>

            <!-- DPS Checkbox -->
            <CheckButton name="$parentDPSCheck" inherits="OptionsCheckButtonTemplate">
                <Size>
                    <AbsDimension x="20" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="220" y="-110"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        this:SetChecked(true);
                    </OnLoad>
                </Scripts>
            </CheckButton>

            <!-- DPS Label -->
            <FontString name="$parentDPSLabel" inherits="GameFontNormal">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="245" y="-110"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Text>DPS</Text>
            </FontString>

            <!-- Description Input -->
            <EditBox name="$parentDescription" inherits="InputBoxTemplate">
                <Size>
                    <AbsDimension x="340" y="25"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="25" y="-170"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        this:SetText("Description: e.g., Fast run, need keys");
                        this:SetTextColor(0.7, 0.7, 0.7, 1);
                    </OnLoad>
                    <OnEditFocusGained>
                        if string.find(this:GetText(), "e.g.,") then
                            this:SetText("");
                            this:SetTextColor(1, 1, 1, 1);
                        end
                    </OnEditFocusGained>
                    <OnEditFocusLost>
                        if this:GetText() == "" then
                            this:SetText("Description: e.g., Fast run, need keys");
                            this:SetTextColor(0.7, 0.7, 0.7, 1);
                        end
                    </OnEditFocusLost>
                    <OnEnterPressed>
                        GroupFinder_CreateGroup();
                    </OnEnterPressed>
                </Scripts>
            </EditBox>

            <!-- Create Button -->
            <Button name="$parentConfirmButton" inherits="UIPanelButtonTemplate" text="Create Group">
                <Size>
                    <AbsDimension x="110" y="25"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="90" y="-250"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        GroupFinder_CreateGroup();
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Cancel Button -->
            <Button name="$parentCancelButton" inherits="UIPanelButtonTemplate" text="Cancel">
                <Size>
                    <AbsDimension x="80" y="25"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="220" y="-250"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        GroupFinderCreateFrame:Hide();
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton");
            </OnLoad>
            <OnShow>
                -- Force UI refresh when create frame becomes visible
                if UpdateInstanceDisplay then
                    UpdateInstanceDisplay();
                end
            </OnShow>
            <OnDragStart>
                this:StartMoving();
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing();
            </OnDragStop>
        </Scripts>
    </Frame>
</Ui>