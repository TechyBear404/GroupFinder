<Ui xmlns="http://www.blizzard.com/wow/ui/">
    
    <!-- Main GroupFinder Frame with New Dynamic Panel Layout -->
    <Frame name="GroupFinderFrame" toplevel="true" frameStrata="DIALOG" movable="true" enableMouse="true" hidden="true" parent="UIParent">
        <Size>
            <AbsDimension x="600" y="500"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize val="32"/>
            <EdgeSize val="32"/>
        </Backdrop>
        <Frames>
            <!-- Title -->
            <FontString name="$parentTitleText" inherits="GameFontNormalLarge">
                <Anchors>
                    <Anchor point="TOP">
                        <Offset>
                            <AbsDimension x="0" y="-15"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Text>Group Finder Enhanced</Text>
            </FontString>
            
            <!-- Close Button -->
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-5" y="-5"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        GroupFinderFrame:Hide();
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Left Panel: Instance Type Selector -->
            <Frame name="$parentLeftPanel">
                <Size>
                    <AbsDimension x="140" y="440"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="20" y="-45"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="2" right="2" top="2" bottom="2"/>
                    </BackgroundInsets>
                    <TileSize val="8"/>
                    <EdgeSize val="8"/>
                </Backdrop>
                <Frames>
                    <!-- Instance Type Label -->
                    <FontString name="$parentTypeLabel" inherits="GameFontNormalSmall">
                        <Anchors>
                            <Anchor point="TOP">
                                <Offset>
                                    <AbsDimension x="0" y="-10"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Text>Instance Type</Text>
                    </FontString>

                    <!-- All Button -->
                    <Button name="$parentAllButton" inherits="UIPanelButtonTemplate" text="All">
                        <Size>
                            <AbsDimension x="120" y="25"/>
                        </Size>
                        <Anchors>
                            <Anchor point="TOP">
                                <Offset>
                                    <AbsDimension x="0" y="-35"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                GroupFinder_SetInstanceType("All");
                            </OnClick>
                        </Scripts>
                    </Button>

                    <!-- Dungeon Button -->
                    <Button name="$parentDungeonButton" inherits="UIPanelButtonTemplate" text="Dungeons">
                        <Size>
                            <AbsDimension x="120" y="25"/>
                        </Size>
                        <Anchors>
                            <Anchor point="TOP">
                                <Offset>
                                    <AbsDimension x="0" y="-65"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                GroupFinder_SetInstanceType("Dungeon");
                            </OnClick>
                        </Scripts>
                    </Button>

                    <!-- Raid Button -->
                    <Button name="$parentRaidButton" inherits="UIPanelButtonTemplate" text="Raids">
                        <Size>
                            <AbsDimension x="120" y="25"/>
                        </Size>
                        <Anchors>
                            <Anchor point="TOP">
                                <Offset>
                                    <AbsDimension x="0" y="-95"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                GroupFinder_SetInstanceType("Raid");
                            </OnClick>
                        </Scripts>
                    </Button>

                    <!-- PvP Button -->
                    <Button name="$parentPvPButton" inherits="UIPanelButtonTemplate" text="PvP">
                        <Size>
                            <AbsDimension x="120" y="25"/>
                        </Size>
                        <Anchors>
                            <Anchor point="TOP">
                                <Offset>
                                    <AbsDimension x="0" y="-125"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                GroupFinder_SetInstanceType("PvP");
                            </OnClick>
                        </Scripts>
                    </Button>

                    <!-- Other Button -->
                    <Button name="$parentOtherButton" inherits="UIPanelButtonTemplate" text="Other">
                        <Size>
                            <AbsDimension x="120" y="25"/>
                        </Size>
                        <Anchors>
                            <Anchor point="TOP">
                                <Offset>
                                    <AbsDimension x="0" y="-155"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnClick>
                                GroupFinder_SetInstanceType("Other");
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
                <Scripts>
                    <OnLoad>
                        this:SetBackdropColor(0.1, 0.1, 0.1, 0.8);
                        this:SetBackdropBorderColor(0.4, 0.4, 0.4, 1);
                    </OnLoad>
                </Scripts>
            </Frame>

            <!-- Right Panel: Dynamic Content Area -->
            <Frame name="$parentRightPanel">
                <Size>
                    <AbsDimension x="400" y="440"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="180" y="-45"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="2" right="2" top="2" bottom="2"/>
                    </BackgroundInsets>
                    <TileSize val="8"/>
                    <EdgeSize val="8"/>
                </Backdrop>
                <Frames>
                    <!-- List View Panel -->
                    <Frame name="$parentListView">
                        <Size>
                            <AbsDimension x="380" y="420"/>
                        </Size>
                        <Anchors>
                            <Anchor point="CENTER"/>
                        </Anchors>
                        <Frames>
                            <!-- Group Count Display -->
                            <FontString name="$parentGroupCount" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="10" y="-10"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Groups found: 0</Text>
                            </FontString>

                            <!-- Add Group Button -->
                            <Button name="$parentAddGroupButton" inherits="UIPanelButtonTemplate" text="Add Group">
                                <Size>
                                    <AbsDimension x="100" y="25"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPRIGHT">
                                        <Offset>
                                            <AbsDimension x="-10" y="-5"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnClick>
                                        GroupFinder_ShowCreateView();
                                    </OnClick>
                                </Scripts>
                            </Button>

                            <!-- Group List Scroll Frame -->
                            <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
                                <Size>
                                    <AbsDimension x="360" y="350"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="10" y="-40"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <ScrollChild>
                                    <Frame name="$parentList">
                                        <Size>
                                            <AbsDimension x="360" y="350"/>
                                        </Size>
                                    </Frame>
                                </ScrollChild>
                            </ScrollFrame>

                            <!-- Action Buttons -->
                            <Button name="$parentRefreshButton" inherits="UIPanelButtonTemplate" text="Refresh">
                                <Size>
                                    <AbsDimension x="70" y="22"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="BOTTOMLEFT">
                                        <Offset>
                                            <AbsDimension x="10" y="10"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnClick>
                                        GroupFinder_RefreshGroups();
                                    </OnClick>
                                </Scripts>
                            </Button>

                            <Button name="$parentCleanupButton" inherits="UIPanelButtonTemplate" text="Cleanup">
                                <Size>
                                    <AbsDimension x="70" y="22"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="BOTTOMLEFT">
                                        <Offset>
                                            <AbsDimension x="90" y="10"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnClick>
                                        CleanupExpiredGroups();
                                    </OnClick>
                                </Scripts>
                            </Button>

                            <Button name="$parentClearButton" inherits="UIPanelButtonTemplate" text="Clear Mine">
                                <Size>
                                    <AbsDimension x="80" y="22"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="BOTTOMLEFT">
                                        <Offset>
                                            <AbsDimension x="170" y="10"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnClick>
                                        GroupFinder_ClearOwnGroups();
                                    </OnClick>
                                </Scripts>
                            </Button>
                        </Frames>
                    </Frame>

                    <!-- Create View Panel -->
                    <Frame name="$parentCreateView" hidden="true">
                        <Size>
                            <AbsDimension x="380" y="420"/>
                        </Size>
                        <Anchors>
                            <Anchor point="CENTER"/>
                        </Anchors>
                        <Frames>
                            <!-- Create Group Title -->
                            <FontString name="$parentTitle" inherits="GameFontNormalLarge">
                                <Anchors>
                                    <Anchor point="TOP">
                                        <Offset>
                                            <AbsDimension x="0" y="-15"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Create Group</Text>
                            </FontString>

                            <!-- Instance Selection -->
                            <FontString name="$parentInstanceLabel" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="-50"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Instance:</Text>
                            </FontString>

                            <FontString name="$parentInstanceDisplay" inherits="GameFontHighlight">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="-70"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>The Deadmines (17-26 - Dungeon)</Text>
                            </FontString>

                            <Button name="$parentInstanceButton" inherits="UIPanelButtonTemplate" text="Select Instance">
                                <Size>
                                    <AbsDimension x="120" y="22"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="240" y="-70"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnClick>
                                        GroupFinder_ShowInstanceDropdown();
                                    </OnClick>
                                </Scripts>
                            </Button>

                            <!-- Roles Section -->
                            <FontString name="$parentRolesLabel" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="-110"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Roles Needed:</Text>
                            </FontString>

                            <!-- Tank Checkbox -->
                            <CheckButton name="$parentTankCheck" inherits="OptionsCheckButtonTemplate">
                                <Size>
                                    <AbsDimension x="20" y="20"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="-135"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnLoad>
                                        this:SetChecked(true);
                                    </OnLoad>
                                </Scripts>
                            </CheckButton>

                            <FontString name="$parentTankLabel" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="45" y="-135"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Tank</Text>
                            </FontString>

                            <!-- Healer Checkbox -->
                            <CheckButton name="$parentHealerCheck" inherits="OptionsCheckButtonTemplate">
                                <Size>
                                    <AbsDimension x="20" y="20"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="120" y="-135"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnLoad>
                                        this:SetChecked(true);
                                    </OnLoad>
                                </Scripts>
                            </CheckButton>

                            <FontString name="$parentHealerLabel" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="145" y="-135"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Healer</Text>
                            </FontString>

                            <!-- DPS Checkbox -->
                            <CheckButton name="$parentDPSCheck" inherits="OptionsCheckButtonTemplate">
                                <Size>
                                    <AbsDimension x="20" y="20"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="220" y="-135"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnLoad>
                                        this:SetChecked(true);
                                    </OnLoad>
                                </Scripts>
                            </CheckButton>

                            <FontString name="$parentDPSLabel" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="245" y="-135"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>DPS</Text>
                            </FontString>

                            <!-- Details Input -->
                            <FontString name="$parentDetailsLabel" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="-170"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Details:</Text>
                            </FontString>

                            <EditBox name="$parentDescription" inherits="InputBoxTemplate">
                                <Size>
                                    <AbsDimension x="340" y="25"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="-195"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnLoad>
                                        this:SetText("Description: e.g., Fast run, need keys");
                                        this:SetTextColor(0.7, 0.7, 0.7, 1);
                                    </OnLoad>
                                    <OnEditFocusGained>
                                        if string.find(this:GetText(), "e.g.,") then
                                            this:SetText("");
                                            this:SetTextColor(1, 1, 1, 1);
                                        end
                                    </OnEditFocusGained>
                                    <OnEditFocusLost>
                                        if this:GetText() == "" then
                                            this:SetText("Description: e.g., Fast run, need keys");
                                            this:SetTextColor(0.7, 0.7, 0.7, 1);
                                        end
                                    </OnEditFocusLost>
                                    <OnEnterPressed>
                                        GroupFinder_CreateGroup();
                                    </OnEnterPressed>
                                </Scripts>
                            </EditBox>

                            <!-- Min Level Checkbox -->
                            <CheckButton name="$parentMinLevelCheck" inherits="OptionsCheckButtonTemplate">
                                <Size>
                                    <AbsDimension x="20" y="20"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="-235"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                            </CheckButton>

                            <FontString name="$parentMinLevelLabel" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="45" y="-235"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Min Level:</Text>
                            </FontString>

                            <EditBox name="$parentMinLevelInput" inherits="InputBoxTemplate">
                                <Size>
                                    <AbsDimension x="50" y="20"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="120" y="-235"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnLoad>
                                        this:SetText("60");
                                        this:SetNumeric(true);
                                        this:SetMaxLetters(2);
                                    </OnLoad>
                                </Scripts>
                            </EditBox>

                            <!-- Voice Chat Checkbox -->
                            <CheckButton name="$parentVoiceChatCheck" inherits="OptionsCheckButtonTemplate">
                                <Size>
                                    <AbsDimension x="20" y="20"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="200" y="-235"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                            </CheckButton>

                            <FontString name="$parentVoiceChatLabel" inherits="GameFontNormal">
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="225" y="-235"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Text>Voice Chat</Text>
                            </FontString>

                            <!-- Voice Chat Input -->
                            <EditBox name="$parentVoiceChatInput" inherits="InputBoxTemplate">
                                <Size>
                                    <AbsDimension x="200" y="20"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="TOPLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="-265"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnLoad>
                                        this:SetText("Discord/TS server...");
                                        this:SetTextColor(0.7, 0.7, 0.7, 1);
                                    </OnLoad>
                                    <OnEditFocusGained>
                                        if string.find(this:GetText(), "Discord") then
                                            this:SetText("");
                                            this:SetTextColor(1, 1, 1, 1);
                                        end
                                    </OnEditFocusGained>
                                    <OnEditFocusLost>
                                        if this:GetText() == "" then
                                            this:SetText("Discord/TS server...");
                                            this:SetTextColor(0.7, 0.7, 0.7, 1);
                                        end
                                    </OnEditFocusLost>
                                </Scripts>
                            </EditBox>

                            <!-- Action Buttons -->
                            <Button name="$parentBackButton" inherits="UIPanelButtonTemplate" text="Back">
                                <Size>
                                    <AbsDimension x="80" y="25"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="BOTTOMLEFT">
                                        <Offset>
                                            <AbsDimension x="20" y="20"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnClick>
                                        GroupFinder_ShowListView();
                                    </OnClick>
                                </Scripts>
                            </Button>

                            <Button name="$parentCreateButton" inherits="UIPanelButtonTemplate" text="Create Group">
                                <Size>
                                    <AbsDimension x="110" y="25"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="BOTTOMRIGHT">
                                        <Offset>
                                            <AbsDimension x="-20" y="20"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                                <Scripts>
                                    <OnClick>
                                        GroupFinder_CreateGroup();
                                    </OnClick>
                                </Scripts>
                            </Button>
                        </Frames>
                    </Frame>
                </Frames>
                <Scripts>
                    <OnLoad>
                        this:SetBackdropColor(0.1, 0.1, 0.1, 0.8);
                        this:SetBackdropBorderColor(0.4, 0.4, 0.4, 1);
                    </OnLoad>
                </Scripts>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad>
                GroupFinder_OnLoad(this);
                this:RegisterForDrag("LeftButton");
            </OnLoad>
            <OnShow>
                GroupFinder_OnShow();
            </OnShow>
            <OnDragStart>
                this:StartMoving();
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing();
            </OnDragStop>
        </Scripts>
    </Frame>

    <!-- Legacy Create Group Dialog (kept for compatibility) -->
